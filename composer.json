{
    "name": "dorialang/baton-php",
    "description": "The initial version of Doria's command-line tool.",
    "type": "project",
    "require": {
        "php": "^8.4",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1",
        "php-collective/toml": "^0.1.5",
        "composer/semver": "^3.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.2"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Doria\\Baton\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doria\\Baton\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "analyse": "@php -d memory_limit=512M vendor/bin/phpstan analyse src tests --level=max --no-progress --debug",
        "lint:packaging": [
            "php -l packaging/build-phar.php",
            "php -l packaging/php-runtime/build.php"
        ],
        "check:phase-f": "php scripts/check_phase_f_package_authority.php",
        "check:stage33-slice1": "php scripts/check_stage33_slice1_manifest_and_inventory.php",
        "build:phar": "php -d phar.readonly=0 packaging/build-phar.php",
        "smoke:phar:stage33-slice1": "php scripts/smoke_stage33_slice1_phar.php build/baton.phar",
        "runtime:plan": "php packaging/php-runtime/build.php --print-plan",
        "check": [
            "@test",
            "@analyse",
            "@lint:packaging",
            "@check:phase-f",
            "@check:stage33-slice1"
        ]
    },
    "authors": [
        {
            "name": "Andrew Masiye",
            "email": "amasiye313@gmail.com"
        }
    ]
}
